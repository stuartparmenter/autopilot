# autopilot v2 configuration
# Copy this file to your project root as `.autopilot.yml` and fill in the values.
#
# Project-specific details (tech stack, test commands, conventions, protected files)
# belong in your project's CLAUDE.md, not here. This file is for orchestration config only.

# ─── Beads (Dolt-backed messaging) ──────────────────────────────────────────
# Beads uses a Dolt database for versioned operational data and inter-agent messaging.

beads:
  dolt_port: 3307                 # Port for the Dolt SQL server
  dolt_data_dir: ".beads/dolt"    # Directory for Dolt data files

# ─── Knowledge Graph ─────────────────────────────────────────────────────────
# The knowledge graph stores codebase understanding, decisions, and relationships.

knowledge_graph:
  provider: "gk"                  # Knowledge graph provider ("gk")
  db_path: ".beads/knowledge.db"  # Path to the knowledge graph database

# ─── Executor ──────────────────────────────────────────────────────────────────
# The executor picks up ready tasks, implements them, and opens PRs.
# Slots are split between builders (implementation) and planners (decomposition).

executor:
  parallel: 8                     # Total max concurrent agents
  builder_slots: 5                # Slots reserved for builder agents
  planner_slots: 3                # Slots reserved for planner agents
  timeout_minutes: 30             # Kill agent after this long
  # fixer_timeout_minutes: 20     # Kill fixer agents after this long (1-120, default: 20)
  # max_fixer_attempts: 3         # Max fixer spawns per PR before giving up (1-10, default: 3)
  poll_interval_minutes: 5        # How often to poll for work (0.5-60, default: 5)
  model: "sonnet"                 # Model for executor agents

# ─── Planning ─────────────────────────────────────────────────────────────────
# The planning system scans the codebase and files improvement tasks.

planning:
  schedule: "when_idle"           # "when_idle" | "daily" | "manual"
  min_ready_threshold: 5          # Only plan when fewer than N tasks are ready
  max_issues_per_run: 5           # Cap on tasks filed per planning run
  # min_interval_minutes: 60      # Minimum minutes between planning runs (0-1440, default: 60)
  model: "opus"                   # Model for the CTO planning agent

# ─── Projects Loop ───────────────────────────────────────────────────────────
# The projects loop manages project-level ownership: triaging tasks, spawning
# technical planners, and completing projects when all work is done.

# projects:
#   enabled: true                 # Enable the projects loop (default: true)
#   poll_interval_minutes: 10     # How often to check projects for triage tasks
#   max_active_projects: 5        # Cap on concurrent project owner agents
#   timeout_minutes: 60           # Kill project owner agent after this long
#   model: "opus"                 # Model for project owner agents

# ─── GitHub ───────────────────────────────────────────────────────────────────
# GitHub integration for PR monitoring, CI checks, and the fixer agent.

github:
  repo: ""                        # "owner/repo" override — leave empty to auto-detect from git remote
  automerge: false                # Enable auto-merge on PRs created by the executor.
                                  # GitHub will merge the PR automatically once all required
                                  # status checks pass. The merge method (squash, merge, rebase)
                                  # is auto-detected from your repo settings. Requires:
                                  #   1. "Allow auto-merge" enabled in repo Settings > General
                                  #   2. Branch protection rules with required status checks
                                  # See: https://docs.github.com/en/pull-requests/collaborating-with-pull-requests/incorporating-changes-from-a-pull-request/automatically-merging-a-pull-request

# ─── Budget ──────────────────────────────────────────────────────────────────
# Cost limits for agent runs. Set to 0 to disable a limit.

budget:
  daily_limit_usd: 0              # Max daily spend (0 = unlimited)
  monthly_limit_usd: 0            # Max monthly spend (0 = unlimited)
  per_agent_limit_usd: 0          # Max spend per agent run (0 = unlimited)
  warn_at_percent: 80             # Warn when budget usage exceeds this percentage

# ─── Sandbox ──────────────────────────────────────────────────────────────────
# OS-level sandbox isolation for agent subprocesses (bubblewrap + socat on Linux).
# Restricts filesystem access to the worktree and optionally limits network.
# Requires: sudo apt-get install bubblewrap socat

# sandbox:
#   enabled: true                 # Enable OS-level sandbox (default: true)
#   auto_allow_bash: true         # Auto-approve bash commands inside the sandbox
#   network_restricted: false     # Restrict network to allowed domains only
#   extra_allowed_domains: []     # Additional domains when network_restricted is true

# ─── Project ──────────────────────────────────────────────────────────────────
# Minimal metadata used by the orchestrator. Everything else goes in CLAUDE.md.

project:
  name: ""                        # Human-readable project name, e.g., "Acme API"
