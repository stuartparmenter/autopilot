{
  "name": "autopilot",
  "version": "0.2.0",
  "type": "module",
  "description": "Fully autonomous AI development loop using Claude Code",
  "scripts": {
    "start": "bun run src/main.ts",
    "setup": "bun run src/setup-project.ts",
    "validate": "bun run src/validate.ts",
    "test": "bun test",
    "check": "bunx biome check ./src",
    "typecheck": "bunx tsc --noEmit",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "ceo": "claude --agent ceo --plugin-dir plugins/autopilot-core --plugin-dir plugins/autopilot-leadership"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.73",
    "hono": "^4.12.7",
    "octokit": "^5.0.5",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
